{
  "name": "@newfoundcodes/helvetium-boot",
  "version": "0.1.0",
  "description": "Helvetium Boot is a web framework with Web-Standard HTTP, routing, middleware, validation, OpenAPI 3.1, RPC, security, WebSockets, server actions, and Helvetium DOM SSR/same-document navigation integration.",
  "type": "module",
  "sideEffects": false,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "type"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./jwt": {
      "types": "./dist/security/jwt.d.ts",
      "import": "./dist/security/jwt.js"
    },
    "./jwk": {
      "types": "./dist/security/jwk.d.ts",
      "import": "./dist/security/jwk.js"
    },
    "./cookies": {
      "types": "./dist/cookies.d.ts",
      "import": "./dist/cookies.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js"
    },
    "./server-actions": {
      "types": "./dist/server-actions.d.ts",
      "import": "./dist/server-actions.js"
    },
    "./helvetium-dom": {
      "types": "./dist/integration/helvetium-dom.d.ts",
      "import": "./dist/integration/helvetium-dom.js"
    },
    "./node": {
      "types": "./dist/adapter/node.d.ts",
      "import": "./dist/adapter/node.js"
    },
    "./package.json": "./package.json",
    "./context-storage": {
      "types": "./dist/context-storage.d.ts",
      "import": "./dist/context-storage.js"
    },
    "./ssg": {
      "types": "./dist/adapter/ssg.d.ts",
      "import": "./dist/adapter/ssg.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    }
  },
  "peerDependencies": {
    "@newfoundcodes/helvetium-dom": ">=0.1.0 <1"
  },
  "peerDependenciesMeta": {
    "@newfoundcodes/helvetium-dom": {
      "optional": true
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "clean": "rm -rf dist coverage site",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples:typecheck": "tsc -p examples/tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "coverage": "npm run build && node --experimental-test-coverage --test tests/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run examples:typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@newfoundcodes/helvetium-dom": ">=0.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "ws": "^8.22.0"
  },
  "keywords": [
    "helvetium",
    "helvetium-boot",
    "web-framework",
    "typescript",
    "router",
    "middleware",
    "rpc",
    "websocket",
    "server-actions",
    "ssr",
    "openapi"
  ]
}
